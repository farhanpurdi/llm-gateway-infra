# =========================
# LiteLLM
# =========================

LITELLM_BASE_URL=http://localhost:4000

LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# =========================
# PostgreSQL
# =========================

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=

DATABASE_URL=

# =========================
# Redis
# =========================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# =========================
# Providers - later
#
# OpenAI
# =========================

OPENAI_API_KEY=

# =========================
# Gateway Config Repository
# =========================

LLM_GATEWAY_CONFIG_DIR=../llm-gateway-config
LITELLM_CONFIG_PATH=../llm-gateway-config/config/litellm_config.yaml

# =========================
# Healthcheck API Key
# =========================

HEALTHCHECK_API_KEY=
